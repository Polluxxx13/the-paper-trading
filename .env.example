# Copier en .env pour docker-compose (Synology / local) — ne jamais committer .env
# Sur Render, ces valeurs se règlent dans le dashboard / render.yaml, pas ici.

# Mot de passe de la base PostgreSQL du conteneur
DB_PASSWORD=changez-moi-mot-de-passe-base

# Mot de passe pour se connecter à l'application (8 caractères minimum)
APP_PASSWORD=changez-moi-mot-de-passe-app

# Clé de signature des sessions : longue et aléatoire (16 caractères minimum)
#   openssl rand -hex 32
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Facultatif
# COOKIE_SECURE=true     # true derrière un proxy HTTPS (reverse proxy Synology)
# APP_PORT=8080          # port exposé sur la machine
